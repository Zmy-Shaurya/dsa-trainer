{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "bundler",
    "noEmit": true, "skipLibCheck": true, "strict": true, "noUncheckedIndexedAccess": true,
    "types": ["node"], "verbatimModuleSyntax": true, "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "scripts", "playwright.config.ts", "tests/e2e", "tests/content", "src/content/types.ts"]
}
